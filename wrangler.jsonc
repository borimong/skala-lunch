{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skala-lunch",
  "account_id": "1273d2c690baee6e98953b45fa6e813b",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-16",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skala-lunch",
      "database_id": "7da6f063-ffcb-4cea-bbb8-e30b4bda3de7",
      "migrations_dir": "./migrations",
    },
  ],
  "vars": {
    "GEMINI_MODEL": "gemini-3.5-flash",
    "PUBLIC_URL": "https://skala-lunch.ewkimhyunsu11.workers.dev",
  },
  // 0 23 * * *: SKALA 오늘의 메뉴(08:00 KST)
  // */20 23,0-3 * * *: 이노밸리 수집/발송(08:00~12:40 KST, 카카오 채널이 월요일 오전에 올라와서 여러 번 확인)
  // 0 20 * * *: 영양정보 계산(05:00 KST, 8시 슬랙 링크 전에 최신 발행 주를 채움 — 이미 계산된 끼니는 건너뜀)
  "triggers": { "crons": ["0 23 * * *", "*/20 23,0-3 * * *", "0 20 * * *"] },
}
